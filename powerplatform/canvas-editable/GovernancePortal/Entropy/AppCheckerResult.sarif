      "tool": {
        "driver": {
          "fullName": "PowerApps app checker",
          "name": "PowerApps app checker",
          "rules": [
            {
              "id": "acc-AccessibleLabelNeeded",
              "messageStrings": {
                "issue": {
                  "text": "Missing accessible label"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Edit the accessible label property to describe the item."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "If there's no accessible text, people who can’t see the screen won't understand what’s in images and controls."
              }
            },
            {
              "id": "acc-TabIndexShouldBeDefinedForInteractiveControl",
              "messageStrings": {
                "issue": {
                  "text": "Missing tab stop"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "People who use the keyboard with your app will not be able to access this element without a tab stop."
              }
            },
            {
              "id": "app-UnusedVariables",
              "messageStrings": {
                "issue": {
                  "text": "Nicht verwendete Variable"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Entfernen Sie die nicht verwendete Variable."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "Diese Variable ist deklariert, wird aber von keinem Steuerelement referenziert und daher nicht benötigt."
              }
            },
            {
              "id": "app-CollectingReadOnlyTable",
              "messageStrings": {
                "issue": {
                  "text": "Die Sammlung wird initialisiert, aber nie aktualisiert"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Ersetzen Sie „Collect“ oder „ClearCollect“ durch eine benannte Formel in „App.Formulas“. Beispiel: MyTable = Filter(Quelle, Bedingung). Benannte Formeln werden berechnet, sobald sich ihre Eingaben ändern, und verursachen nicht die Überwachungskosten einer Abfrage."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "Sammlungen sollen aktualisiert werden. Power Apps erledigt zusätzliche Arbeit, um jede Sammlung nachzuverfolgen, sodass alles, was davon abhängt, synchron bleibt, wenn sich die Daten ändern. Wenn sich die Daten nach ihrer Festlegung nicht mehr ändern, ist dieser Nachverfolgungsaufwand umsonst. Eine benannte Formel liefert dieselben Daten ohne zusätzliche Kosten."
              }
            }
          ],
          "version": "1.349"
        }
      }
    }
  ],
  "version": "2.1.0"
