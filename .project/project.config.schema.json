{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-engineering-framework/project.config.schema.json",
  "title": "Project Engineering Framework configuration",
  "type": "object",
  "required": ["schemaVersion", "frameworkVersion", "project", "companion", "modules", "quality", "release", "documentation"],
  "properties": {
    "schemaVersion": {"const": 1},
    "frameworkVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "project": {
      "type": "object",
      "required": ["key", "name", "versionFile"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "locale": {"type": "string"},
        "versionFile": {"type": "string", "minLength": 1},
        "versionJsonKey": {"type": "string"}
      }
    },
    "companion": {
      "type": "object",
      "required": ["host", "port"],
      "properties": {
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "openBrowser": {"type": "boolean"}
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "tagline": {"type": "string"},
        "showProjectMemory": {"type": "boolean"},
        "showRoadmap": {"type": "boolean"},
        "showRunbooks": {"type": "boolean"},
        "firstRunWizard": {"type": "boolean"},
        "projectUI": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "allowCustomAssets": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "quality": {
      "type": "object",
      "required": ["projectMemoryContract", "technicalDebtReview", "requiredDocumentationStatus"],
      "properties": {
        "projectMemoryContract": {"type": "boolean"},
        "technicalDebtReview": {"type": "boolean"},
        "verificationEvidence": {"type": "boolean"},
        "requiredDocumentationStatus": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "supportedPython": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
        },
        "ciPlatforms": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["ubuntu", "macos", "windows"]}
        }
      }
    },
    "repositoryPolicy": {
      "type": "object",
      "properties": {
        "requireProtectedBaseBranch": {"type": "boolean"}
      }
    },
    "release": {
      "type": "object",
      "required": ["enabled", "confirmation", "baseBranch", "mergeMethod", "gates"],
      "properties": {
        "enabled": {"type": "boolean"},
        "confirmation": {"type": "string", "minLength": 1},
        "baseBranch": {"type": "string", "minLength": 1},
        "mergeMethod": {"enum": ["squash", "merge", "rebase"]},
        "commitDirty": {"type": "boolean"},
        "allowNoChecks": {"type": "boolean"},
        "createTag": {"type": "boolean"},
        "tagPrefix": {"type": "string"},
        "createGitHubRelease": {"type": "boolean"},
        "gates": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "powerPlatform": {"type": "object"},
    "provisioning": {"type": "object"},
    "documentation": {"type": "object"}
  }
}
